# Frontend: public values only. Never put a service role key under a VITE_ name.
VITE_APP_MODE=production
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY

# Netlify Functions: server-only. Configure in Netlify environment settings.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_OR_SECRET_KEY
APP_URL=https://YOUR_SITE.netlify.app

# Presence credentials must only be configured after reviewing its official API.
# No automatic vendor adapter is enabled in this version.
